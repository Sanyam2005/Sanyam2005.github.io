---
import Base from '../../layouts/Base.astro';
import { projects, site } from '../../data/site';
import { videoOf } from '../../data/media';
import ProjectArt from '../../components/ProjectArt.astro';

export function getStaticPaths() {
  return projects.filter((p) => (p.page || videoOf(p)) && !p.draft).map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const page = p.page;
const video = videoOf(p);
const yt = video?.includes('youtube.com/embed/');
const code = p.links.find((l) => l.href.includes('github.com'));
const jsonld = {
  '@context': 'https://schema.org',
  '@type': code ? 'SoftwareSourceCode' : 'CreativeWork',
  name: p.title,
  description: p.impact,
  url: new URL(`/projects/${p.slug}/`, site.url).href,
  author: { '@type': 'Person', name: site.name, url: site.url },
  ...(code ? { codeRepository: code.href } : {}),
  keywords: p.stack.join(', '),
};
const ext = '<svg class="ext" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12"/></svg>';
---
<Base title={`${p.title}, a project by Sanyam Agrawal`} description={p.impact} jsonld={jsonld}>
  <main id="main" class="doc">
    <nav class="crumbs"><a href="/">Sanyam Agrawal</a><span aria-hidden="true">/</span><a href="/#projects">Projects</a></nav>
    <h1>{p.title}</h1>
    <p class="kind">{p.kind}</p>
    <p class="summary">{p.impact}</p>
    <div class="links">{p.links.map((l) => <a class="pill" href={l.href}>{l.label} <Fragment set:html={ext} /></a>)}</div>
    {video
      ? (yt ? <div class="frame"><iframe src={video} title={`${p.title} demo`} loading="lazy" allowfullscreen></iframe></div>
            : <video class="frame" src={video} controls preload="metadata" playsinline></video>)
      : p.image ? <img class="frame" src={p.image} alt={`${p.title} results`} width="1200" height="660" />
        : <div class="frame art-frame"><ProjectArt slug={p.slug} title={p.title} /></div>}
    {page && (
      <div class="sections">
        <section><h2>The problem</h2><p>{page.problem}</p></section>
        <section><h2>What I built</h2><ul>{page.built.map((b) => <li>{b}</li>)}</ul></section>
        <section><h2>Result</h2><p>{page.outcome}</p></section>
      </div>
    )}
    {p.stack.length > 0 && <div class="stack">{p.stack.map((t) => <span class="pill tech">{t}</span>)}</div>}
  </main>
</Base>

<style>
  .doc { max-width: 780px; margin: 0 auto; padding: 48px 24px 96px; }
  .crumbs { display: flex; gap: 10px; font: 400 14px/1 var(--mono); color: var(--ink-3); margin-bottom: 48px; }
  .crumbs a { color: var(--ink-2); }
  h1 { font-size: clamp(34px, 5vw, 52px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; }
  .kind { margin-top: 10px; color: var(--ink-3); font: 400 15px/1.4 var(--mono); }
  .summary { margin-top: 24px; font-size: 19px; line-height: 1.6; color: var(--ink); }
  .links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .frame { display: block; width: 100%; margin-top: 32px; border: 1px solid var(--line); border-radius: 16px; background: var(--card); aspect-ratio: 16 / 9; object-fit: contain; }
  .art-frame { display: flex; align-items: center; justify-content: center; aspect-ratio: 16 / 7; }
  .art-frame :global(.art) { width: 92%; height: 88%; }
  .frame iframe { width: 100%; height: 100%; border: 0; border-radius: 16px; }
  .sections { margin-top: 24px; display: grid; gap: 16px; }
  section { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 20px 22px; }
  h2 { font: 500 14px/1.2 var(--mono); color: var(--ink-3); margin-bottom: 10px; }
  section p, section li { color: var(--ink-2); font-size: 16px; line-height: 1.65; }
  ul { margin: 0; padding-left: 1.1em; display: grid; gap: 8px; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 24px; }
</style>
